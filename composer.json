{
    "name": "horde/alarm",
    "description": "Alarm library",
    "type": "library",
    "homepage": "https://www.horde.org/libraries/Horde_Alarm",
    "license": "LGPL-2.1-only",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        }
    ],
    "time": "2025-05-05",
    "repositories": [],
    "require": {
        "php": "^7.4 || ^8",
        "horde/date": "^3",
        "horde/exception": "^3",
        "horde/translation": "^3"
    },
    "require-dev": {
        "horde/cli": "^3",
        "horde/db": "^3",
        "horde/log": "^3",
        "horde/mail": "^3",
        "horde/mime": "^3",
        "horde/notification": "^3",
        "horde/serialize": "^3",
        "horde/test": "^3",
        "phpunit/phpunit": "^12 || ^11 || ^10 || ^9",
        "phpstan/phpstan": "^2",
        "friendsofphp/php-cs-fixer": "^3"
    },
    "suggest": {
        "horde/db": "^3",
        "horde/log": "^3",
        "horde/mail": "^3",
        "horde/mime": "^3",
        "horde/notification": "^3"
    },
    "autoload": {
        "psr-0": {
            "Horde_Alarm": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Alarm\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    }
}